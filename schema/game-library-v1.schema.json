{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/retro-trans/retro-trans-tools/main/schema/game-library-v1.schema.json",
  "title": "Retro Trans cross-platform game library",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "games",
    "vita_releases"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "games": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "$ref": "#/$defs/game"
      }
    },
    "vita_releases": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "$ref": "#/$defs/vita_release"
      }
    }
  },
  "$defs": {
    "package_ids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "platform",
          "kind",
          "id"
        ],
        "properties": {
          "platform": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "kind": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,39}$"
          },
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          }
        }
      }
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bytes",
        "sha256"
      ],
      "properties": {
        "bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 17179869184
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bytes",
        "sha256",
        "name",
        "id"
      ],
      "properties": {
        "bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 17179869184
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "id": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "game": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "game_id",
        "name",
        "repo",
        "package_ids"
      ],
      "properties": {
        "game_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "repo": {
          "type": "string",
          "pattern": "^retro-trans/[A-Za-z0-9_.-]+$"
        },
        "package_ids": {
          "$ref": "#/$defs/package_ids"
        }
      }
    },
    "vita_release": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "game_id",
        "repo",
        "version",
        "mode",
        "content_id",
        "package",
        "profile",
        "archive"
      ],
      "properties": {
        "game_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "repo": {
          "type": "string",
          "pattern": "^retro-trans/[A-Za-z0-9_.-]+$"
        },
        "version": {
          "type": "string",
          "pattern": "^0\\.\\d+\\.\\d+$"
        },
        "mode": {
          "enum": [
            "pkg",
            "repatch"
          ]
        },
        "content_id": {
          "type": "string",
          "pattern": "^[A-Z]{2}[0-9]{4}-[A-Z]{4}[0-9]{5}_00-[A-Z0-9_]{16}$"
        },
        "package": {
          "$ref": "#/$defs/identity"
        },
        "profile": {
          "$ref": "#/$defs/asset"
        },
        "archive": {
          "$ref": "#/$defs/asset"
        }
      }
    }
  }
}
