{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/retro-trans/retro-trans-tools/main/schema/game-release-v2.schema.json",
  "title": "Retro Trans game release v2 (multi-file solutions)",
  "type": "object",
  "required": ["schema_version", "game_id", "game_name", "platform", "version", "source_commit", "patches", "solutions"],
  "properties": {
    "schema_version": {"const": 2},
    "game_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
    "game_name": {"$ref": "#/$defs/text"},
    "platform": {"$ref": "#/$defs/text"},
    "version": {"$ref": "game-release-v1.schema.json#/$defs/version"},
    "source_commit": {"type": "string", "pattern": "^[a-fA-F0-9]{40}$"},
    "patches": {"type": "array", "minItems": 1, "items": {"$ref": "game-release-v1.schema.json#/$defs/patch"}},
    "solutions": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/solution"}}
  },
  "$defs": {
    "text": {"type": "string", "minLength": 1, "maxLength": 200},
    "filename": {"type": "string", "minLength": 1, "maxLength": 200, "pattern": "^[^<>:\"/\\\\|?*\\u0000-\\u001f]+$"},
    "solution": {
      "type": "object",
      "required": ["id", "name", "edition", "language", "files"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,99}$"},
        "name": {"$ref": "#/$defs/text"},
        "edition": {"$ref": "#/$defs/text"},
        "language": {"$ref": "#/$defs/text"},
        "files": {
          "type": "array", "minItems": 2,
          "items": {
            "type": "object", "required": ["edition", "output_name"],
            "properties": {
              "edition": {"$ref": "#/$defs/text"},
              "output_name": {"$ref": "#/$defs/filename"}
            }
          }
        },
        "copy_files": {
          "type": "array",
          "items": {
            "type": "object", "required": ["name", "bytes", "sha256"],
            "not": {"required": ["source"]},
            "properties": {
              "name": {"$ref": "#/$defs/filename"},
              "bytes": {"$ref": "game-release-v1.schema.json#/$defs/bytes"},
              "sha256": {"$ref": "game-release-v1.schema.json#/$defs/hash"}
            }
          }
        }
      }
    }
  }
}
